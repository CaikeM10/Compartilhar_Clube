generator client {
  provider = "prisma-client-js"
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Lesson {
  id              String       @id @default(cuid())
  title           String
  description     String
  videoUrl        String
  durationMinutes Int
  position        Int
  status          LessonStatus @default(DRAFT)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, position])
  @@map("lessons")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// 👤 USERS 
//////////////////////////////////////////////////////

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  password      String?
  createdAt     DateTime @default(now())

  subscriptions Subscription[]

  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(STUDENT)
  disabledAt    DateTime?
  isPrincipalAdmin   Boolean           @default(false)
  mustChangePassword Boolean           @default(false)
  adminAuditActions  AdminAuditEvent[] @relation("AdminAuditActor")
  adminAuditTargets  AdminAuditEvent[] @relation("AdminAuditTarget")
  manualAccessGrant   ManualAccessGrant?  @relation("ManualAccessGrantUser")
  manualAccessGranted ManualAccessGrant[] @relation("ManualAccessGrantGrantedBy")
  manualAccessRevoked ManualAccessGrant[] @relation("ManualAccessGrantRevokedBy")
  manualAccessActions ManualAccessEvent[] @relation("ManualAccessEventActor")
  manualAccessTargets ManualAccessEvent[] @relation("ManualAccessEventTarget")
  updatedAt     DateTime @default(now()) @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

enum Role {
  ADMIN
  STUDENT
}

model Account {
  id                    String   @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("auth_verifications")
}

//////////////////////////////////////////////////////
// 📦 PLANOS
//////////////////////////////////////////////////////

model Plan {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Int
  duration  Int

  createdAt DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

//////////////////////////////////////////////////////
// 💳 ASSINATURAS
//////////////////////////////////////////////////////

model Subscription {
  id        String   @id @default(cuid())

  userId    String
  planId    String

  status    String

  startDate DateTime @default(now())
  endDate   DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

//////////////////////////////////////////////////////
// 💰 PAGAMENTOS
//////////////////////////////////////////////////////

model Payment {
  id            String   @id @default(cuid())
  mercadopagoId String   @unique
  email         String
  plan          String
  status        String
  amount        Int

  createdAt     DateTime @default(now())

  @@map("payments")
}

// Admin user management: applied only with explicit authorization (prisma/proposals/admin-users.sql).
enum AdminAuditAction {
  USER_CREATED
  ROLE_CHANGED
  PRINCIPAL_DESIGNATED
  OPERATOR_PASSWORD_RESET
}

model AdminAuditEvent {
  id           String           @id @default(cuid())
  action       AdminAuditAction
  actorId      String?
  targetUserId String
  previousRole Role?
  newRole      Role?
  createdAt    DateTime         @default(now())

  actor  User? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  target User  @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@map("admin_audit_events")
}

// Manual access grants: applied only with explicit authorization (prisma/proposals/manual-access.sql).
// Independent from Plan/Subscription/Payment: an administrative grant is never a payment, plan or subscription.
enum ManualAccessAction {
  GRANTED
  RENEWED
  REVOKED
}

model ManualAccessGrant {
  id          String    @id @default(cuid())
  userId      String    @unique
  startsAt    DateTime
  endsAt      DateTime
  revokedAt   DateTime?
  grantedById String
  revokedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  user      User                @relation("ManualAccessGrantUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User                @relation("ManualAccessGrantGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy User?               @relation("ManualAccessGrantRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  events    ManualAccessEvent[]

  @@index([grantedById])
  @@index([revokedById])
  @@map("manual_access_grants")
}

model ManualAccessEvent {
  id               String             @id @default(cuid())
  action           ManualAccessAction
  grantId          String
  actorId          String
  targetUserId     String
  previousStartsAt DateTime?
  previousEndsAt   DateTime?
  newStartsAt      DateTime?
  newEndsAt        DateTime?
  createdAt        DateTime           @default(now())

  grant  ManualAccessGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)
  actor  User              @relation("ManualAccessEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  target User              @relation("ManualAccessEventTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([grantId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@map("manual_access_events")
}

// Catalog models: applied only to the explicitly authorized local test database.
enum MaterialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MaterialAssetStatus {
  PENDING
  VALIDATED
  REJECTED
  ARCHIVED
}

model Material {
  id           String         @id @default(cuid())
  title        String
  description  String?
  priceCents   Int
  currency     String         @default("BRL")
  coverImage   String
  checkoutUrl  String?
  isPremium    Boolean        @default(false)
  displayOrder Int
  status       MaterialStatus @default(DRAFT)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assets       MaterialAsset[]

  @@index([status, displayOrder])
  @@map("materials")
}

model MaterialAsset {
  id               String              @id @default(cuid())
  materialId       String
  storageKey       String              @unique
  originalFilename String
  mimeType         String
  fileSize         Int
  checksum         String?
  version          Int
  status           MaterialAssetStatus @default(PENDING)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  material         Material            @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([materialId, version])
  @@index([materialId, status])
  @@map("material_assets")
}
