  USER_CREATED
  ROLE_CHANGED
  PRINCIPAL_DESIGNATED
  OPERATOR_PASSWORD_RESET
}

model AdminAuditEvent {
  id           String           @id @default(cuid())
  action       AdminAuditAction
  actorId      String?
