# Arquivos de texto ficam em LF no repositório e na cópia de trabalho, em qualquer sistema.
# Os testes de integridade (hashes e fixtures em docs/) dependem de bytes estáveis entre
# Windows, Linux/CI e Vercel.
* text=auto eol=lf

# Binários: nunca converter finais de linha nem gerar diff textual.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# Scripts nativos do Windows exigem CRLF (nenhum versionado hoje).
*.bat text eol=crlf
*.cmd text eol=crlf
